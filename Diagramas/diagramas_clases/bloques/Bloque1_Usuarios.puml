@startuml
' =====================================================
'  DIAGRAMA DE CLASES · Sistema de facturación y cobros de Turbine
'  Cada bloque tiene su color. El color de cada línea indica
'  el bloque del que sale. Los comentarios explican las relaciones.
' =====================================================


' ---------- Aspecto (colores y espacios) ----------
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageBorderColor #BBBBBB
skinparam packageFontSize 15
skinparam packageFontStyle bold
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #C9B458
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #BBBBBB
hide circle
hide stereotype

' ---------- Líneas más ordenadas ----------
' Las líneas van en ángulo recto y con más espacio entre cajas.
' Si algún texto de una línea se ve mal, cambia "ortho" por "polyline".
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 90
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 10
skinparam ArrowFontColor #333333

skinparam class {
  BorderThickness 1.3
  BackgroundColor<<B1>> #DCEBFA
  BorderColor<<B1>>     #2F6DB5
  BackgroundColor<<B2>> #E9E4F5
  BorderColor<<B2>>     #6A4FB0
  BackgroundColor<<B3>> #DFF2E1
  BorderColor<<B3>>     #2E8B57
  BackgroundColor<<B4>> #FDE9D3
  BorderColor<<B4>>     #D9822B
  BackgroundColor<<B5>> #FBE0E0
  BorderColor<<B5>>     #C0392B
  BackgroundColor<<B6>> #FFF4C9
  BorderColor<<B6>>     #B8960C
  BackgroundColor<<EN>> #ECECEC
  BorderColor<<EN>>     #7F7F7F
}

legend left
  |= Color |= Bloque (y color de sus líneas) |
  |<#DCEBFA>     | 1 · Usuarios, accesos y trabajo diario |
  |<#E9E4F5>     | 2 · Configuración, auditoría y datos |
  |<#DFF2E1>     | 3 · Clientes y suscripciones |
  |<#FDE9D3>     | 4 · Facturación, presupuestos y aprobaciones |
  |<#FBE0E0>     | 5 · Cobros, impagos e incidencias |
  |<#FFF4C9>     | 6 · Informes, paquetes y operaciones masivas |
  |<#ECECEC>     | Enumeraciones (listas de valores posibles) |
endlegend

title Sistema de facturación y cobros de Turbine · 1 · Usuarios, accesos y trabajo diario
hide empty members

package "1 · Usuarios, accesos y trabajo diario" #F4F8FD {
  Class Usuario <<B1>> {
  - int idUsuario
  - String nombre
  - String correoCorporativo
  - String passwordHash
  - RolUsuario rol
  - bool puedeGestionarUsuarios
  - bool activo
  - int intentosFallidos
  - DateTime bloqueadoHasta
  - List<CanalNotificacion> canalesPreferidos

  + Sesion iniciarSesion(String correo, String pass)
  + void cerrarSesion()
  + void recuperarPassword()
  + bool enviarInvitacion()
  + void reactivarCuenta()
  + void desactivarCuenta(String motivo)
  + void invalidarSesionesActivas()
  + void configurarCanales(List<CanalNotificacion> canales)
  }

  Class Sesion <<B1>> {
  - String idSesion
  - String token
  - DateTime fechaInicio
  - DateTime ultimaActividad
  - String direccionIP
  - String dispositivo
  - bool activa

  + bool esValida()
  + void invalidar()
  }

  Class DelegacionTemporal <<B1>> {
  - int idDelegacion
  - Date fechaInicio
  - Date fechaFin
  - bool activa

  + void activarDelegacion()
  + void cancelarDelegacion()
  + bool estaVigente(Date fecha)
  }

  Class Notificacion <<B1>> {
  - int idNotificacion
  - String mensaje
  - DateTime fechaCreacion
  - EstadoNotificacion estado
  - CanalNotificacion canal

  + void marcarComoLeida()
  + void marcarComoAtendida()
  + bool enviar()
  }

  Class AlertaCorporativa <<B1>> {
  - int idAlerta
  - String nombre
  - String condicionEvaluacion
  - CanalNotificacion canal
  - bool activa

  + bool evaluarCondicion(Object contexto)
  + void dispararAlerta()
  }

  Class Comentario <<B1>> {
  - int idComentario
  - String texto
  - DateTime fechaCreacion
  - bool restringidoSoloAdmin

  + void publicar()
  + void notificarMencionados()
  }

  Class DocumentoAdjunto <<B1>> {
  - int idDocumento
  - String nombreArchivo
  - FormatoArchivo formato
  - long tamanoBytes
  - String rutaAlmacenamiento
  - DateTime fechaSubida

  + bool validarFormatoYTamano()
  + File descargar()
  }

}

' Clases de otros bloques: solo el nombre (el detalle está en su bloque)
package "Clases de otros bloques" #FFFFFF {
  Class CopiaSeguridad <<B2>>
  Class RegistroAuditoria <<B2>>
  Class Cliente <<B3>>
  Class ImportacionClientes <<B3>>
  Class Factura <<B4>>
  Class Presupuesto <<B4>>
  Class SolicitudAprobacion <<B4>>
  Class Cobro <<B5>>
  Class Incidencia <<B5>>
  Class AccionMasiva <<B6>>
  Class Informe <<B6>>
  Class PaqueteGestoria <<B6>>
}

' Relaciones en las que participa alguna clase de este bloque
Usuario "1" *-[#2F6DB5]- "0..*" Sesion : -sesionesActivas
Usuario "0..1" -[#2F6DB5]-> "0..*" Cliente : -clientesAsignados
Usuario "0..*" -[#2F6DB5]-> "0..*" Cliente : -favoritos
Usuario "1" -[#2F6DB5]-> "0..*" Notificacion : -notificaciones
DelegacionTemporal "0..*" -[#2F6DB5]-> "1" Usuario : -titular
DelegacionTemporal "0..*" -[#2F6DB5]-> "1" Usuario : -sustituto
DelegacionTemporal "0..*" -[#2F6DB5]-> "0..*" Cliente : -clientesDelegados
AlertaCorporativa "0..*" -[#2F6DB5]-> "0..*" Usuario : -destinatarios
Comentario "0..*" -[#2F6DB5]-> "1" Usuario : -autor
Comentario "0..*" -[#2F6DB5]-> "0..*" Usuario : -mencionados
Comentario "0..*" -[#2F6DB5]-> "0..1" Cliente
Comentario "0..*" -[#2F6DB5]-> "0..1" Factura
Comentario "0..*" -[#2F6DB5]-> "0..1" Incidencia
DocumentoAdjunto "0..*" -[#2F6DB5]-> "1" Usuario : -subidoPor
DocumentoAdjunto "0..*" <-[#2E8B57]- "0..1" Cliente
DocumentoAdjunto "0..*" <-[#D9822B]- "0..1" Factura
DocumentoAdjunto "0..*" <-[#C0392B]- "0..1" Incidencia
RegistroAuditoria "0..*" -[#6A4FB0]-> "0..1" Usuario : -autor
CopiaSeguridad "0..*" -[#6A4FB0]-> "0..1" Usuario : -restauradaPor
ImportacionClientes "0..*" -[#2E8B57]-> "1" Usuario : -ejecutadoPor
Presupuesto "0..1" -[#D9822B]-> "0..1" DocumentoAdjunto : -evidencia
Factura "0..1" -[#D9822B]-> "0..1" DocumentoAdjunto : -pdfEmitido
SolicitudAprobacion "0..*" -[#D9822B]-> "1" Usuario : -solicitante
SolicitudAprobacion "0..*" -[#D9822B]-> "0..1" Usuario : -aprobador
SolicitudAprobacion "0..*" -[#D9822B]-> "0..1" Usuario : -asignadoA
Cobro "0..1" -[#C0392B]-> "0..1" DocumentoAdjunto : -justificante
Incidencia "0..*" -[#C0392B]-> "1" Usuario : -responsable
Informe "0..*" -[#B8960C]-> "1" Usuario : -generadoPor
Informe "0..*" -[#B8960C]-> "0..1" Usuario : -filtroResponsable
Informe "0..1" -[#B8960C]-> "0..1" DocumentoAdjunto : -archivoGenerado
PaqueteGestoria "0..1" -[#B8960C]-> "0..1" DocumentoAdjunto : -archivoZip
PaqueteGestoria "0..*" -[#B8960C]-> "1" Usuario : -generadoPor
AccionMasiva "0..*" -[#B8960C]-> "1" Usuario : -ejecutadoPor

note bottom of Comentario : {xor} sobre un cliente,\nuna factura o una incidencia
note bottom of DocumentoAdjunto : {xor} cada documento pertenece\na un único elemento

@enduml

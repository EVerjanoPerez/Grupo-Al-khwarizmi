@startuml
' =====================================================
'  DIAGRAMA DE CLASES · Sistema de facturación y cobros de Turbine
'  Cada bloque tiene su color. El color de cada línea indica
'  el bloque del que sale. Los comentarios explican las relaciones.
' =====================================================


' ---------- Aspecto (colores y espacios) ----------
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageBorderColor #BBBBBB
skinparam packageFontSize 15
skinparam packageFontStyle bold
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #C9B458
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #BBBBBB
hide circle
hide stereotype

' ---------- Líneas más ordenadas ----------
' Las líneas van en ángulo recto y con más espacio entre cajas.
' Si algún texto de una línea se ve mal, cambia "ortho" por "polyline".
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 90
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 10
skinparam ArrowFontColor #333333

skinparam class {
  BorderThickness 1.3
  BackgroundColor<<B1>> #DCEBFA
  BorderColor<<B1>>     #2F6DB5
  BackgroundColor<<B2>> #E9E4F5
  BorderColor<<B2>>     #6A4FB0
  BackgroundColor<<B3>> #DFF2E1
  BorderColor<<B3>>     #2E8B57
  BackgroundColor<<B4>> #FDE9D3
  BorderColor<<B4>>     #D9822B
  BackgroundColor<<B5>> #FBE0E0
  BorderColor<<B5>>     #C0392B
  BackgroundColor<<B6>> #FFF4C9
  BorderColor<<B6>>     #B8960C
  BackgroundColor<<EN>> #ECECEC
  BorderColor<<EN>>     #7F7F7F
}

legend left
  |= Color |= Bloque (y color de sus líneas) |
  |<#DCEBFA>     | 1 · Usuarios, accesos y trabajo diario |
  |<#E9E4F5>     | 2 · Configuración, auditoría y datos |
  |<#DFF2E1>     | 3 · Clientes y suscripciones |
  |<#FDE9D3>     | 4 · Facturación, presupuestos y aprobaciones |
  |<#FBE0E0>     | 5 · Cobros, impagos e incidencias |
  |<#FFF4C9>     | 6 · Informes, paquetes y operaciones masivas |
  |<#ECECEC>     | Enumeraciones (listas de valores posibles) |
endlegend

title Sistema de facturación y cobros de Turbine · 3 · Clientes y suscripciones
hide empty members

package "3 · Clientes y suscripciones" #F4FBF5 {
  Class Cliente <<B3>> {
  - int idCliente
  - String razonSocial
  - String nif
  - String direccionFiscal
  - String pais
  - String sector
  - List<String> etiquetas
  - EstadoCliente estado
  - Date fechaBaja
  - bool eliminadoLogico

  + bool darDeAlta()
  + void reactivar()
  + void modificarDatosFiscales()
  + void asignarResponsable(Usuario u)
  + void desasignarResponsable()
  + RevisionRango iniciarRevisionRango(double importe, String fuente, Date fecha)
  + List<Factura> obtenerFacturasPendientes()
  + double calcularDeudaTotal()
  + void darDeBaja(Date fechaEfectiva)
  + void borradoLogico(String motivo)
  }

  Class RevisionRango <<B3>> {
  - int idRevision
  - Date fechaRevision
  - double facturacionAnualRegistrada
  - String fuenteDato
  - Date fechaEfecto
  - String motivoCorreccion

  + SolicitudAprobacion solicitarAprobacionCambio()
  + void aplicarCambioRango()
  }

  Class ContactoCliente <<B3>> {
  - int idContacto
  - String nombre
  - String email
  - String telefono
  - String funcion
  - String idioma
  - bool consienteWhatsApp

  + CanalNotificacion obtenerCanalEnvio()
  + void anonimizarDatos()
  + void eliminarDatos()
  }

  Class ImportacionClientes <<B3>> {
  - int idImportacion
  - String nombreArchivo
  - DateTime fechaEjecucion
  - Map<String, String> mapeoColumnas
  - int totalFilas
  - int filasExitosas
  - int filasConError
  - int filasDuplicadas
  - List<String> erroresDetalle

  + bool cargarArchivo(File archivo)
  + void definirMapeo(Map<String, String> mapeo)
  + bool validarFilas()
  + List<Cliente> procesarImportacion()
  + String obtenerResumen()
  }

  Class Suscripcion <<B3>> {
  - int idSuscripcion
  - String plan
  - double cuotaMensual
  - int diaVencimientoPactado
  - Date fechaInicio
  - Date fechaFin
  - EstadoSuscripcion estado
  - String motivoPausa
  - Date fechaInicioPausa
  - Date fechaReactivacionPrevista

  + void activar()
  + double calcularProrrateo(Date fechaAlta)
  + void pausar(Date fechaInicio, Date fechaReactivacion, String motivo)
  + void reactivar()
  + void cancelar(Date fechaEfectiva)
  + void actualizarTarifa(TarifaRango nuevoRango, Date fechaEfecto)
  + void agregarExcepcion(ExcepcionComercial e)
  + List<ExcepcionComercial> obtenerExcepcionesVigentes(Date mes)
  + double calcularImporteMensual(Date mes)
  + Factura generarFacturaMensual(Date mes)
  }

  Class ExcepcionComercial <<B3>> {
  - int idExcepcion
  - TipoExcepcion tipo
  - double valor
  - String motivo
  - Date fechaInicio
  - Date fechaFin
  - bool vigente

  + SolicitudAprobacion solicitarAprobacion()
  + double aplicarEnCuota(double importeBase)
  }

}

' Clases de otros bloques: solo el nombre (el detalle está en su bloque)
package "Clases de otros bloques" #FFFFFF {
  Class Comentario <<B1>>
  Class DelegacionTemporal <<B1>>
  Class DocumentoAdjunto <<B1>>
  Class Usuario <<B1>>
  Class ConfiguracionSistema <<B2>>
  Class TarifaRango <<B2>>
  Class Factura <<B4>>
  Class Presupuesto <<B4>>
  Class SolicitudAprobacion <<B4>>
  Class Incidencia <<B5>>
  Class Informe <<B6>>
}

' Relaciones en las que participa alguna clase de este bloque
Cliente "1" *-[#2E8B57]- "1..*" ContactoCliente
Usuario "0..1" -[#2F6DB5]-> "0..*" Cliente : -clientesAsignados
Usuario "0..*" -[#2F6DB5]-> "0..*" Cliente : -favoritos
DelegacionTemporal "0..*" -[#2F6DB5]-> "0..*" Cliente : -clientesDelegados
Comentario "0..*" -[#2F6DB5]-> "0..1" Cliente
DocumentoAdjunto "0..*" <-[#2E8B57]- "0..1" Cliente
Cliente "0..*" -[#2E8B57]-> "1" TarifaRango : -rangoActual
Cliente "1" -[#2E8B57]-> "0..*" RevisionRango : -historialRevisiones
RevisionRango "0..*" -[#2E8B57]-> "1" TarifaRango : -rangoAnterior
RevisionRango "0..*" -[#2E8B57]-> "1" TarifaRango : -rangoNuevo
ImportacionClientes "0..*" -[#2E8B57]-> "1" Usuario : -ejecutadoPor
Cliente "1" -[#2E8B57]-> "0..*" Suscripcion : -suscripciones
Suscripcion "1" -[#2E8B57]-> "0..*" ExcepcionComercial : -excepciones
Cliente "1" -[#2E8B57]-> "0..*" Factura : -facturas
Cliente "1" -[#2E8B57]-> "0..*" Presupuesto : -presupuestos
Suscripcion "0..1" -[#2E8B57]-> "0..*" Factura : -facturasGeneradas
SolicitudAprobacion "0..1" <-[#2E8B57]- "0..1" RevisionRango
SolicitudAprobacion "0..1" <-[#2E8B57]- "0..1" ExcepcionComercial
SolicitudAprobacion "0..*" <-[#2E8B57]- "0..1" Suscripcion
Incidencia "0..*" -[#C0392B]-> "0..1" Cliente
Informe "0..*" -[#B8960C]-> "0..1" Cliente : -filtroCliente
RevisionRango .[#2E8B57].> ConfiguracionSistema : <<uses>>


@enduml

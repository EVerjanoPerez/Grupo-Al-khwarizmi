' ---------- Composiciones ----------
Usuario "1" *-- "0..*" Sesion : -sesionesActivas
CalendarioLaboral "1" *-- "0..*" DiaFestivo : -festivos
Factura "0..1" *-- "1..*" LineaFactura
Presupuesto "0..1" *-- "1..*" LineaFactura
Cliente "1" *-- "1..*" ContactoCliente

note right of LineaFactura : {xor} cada línea pertenece\na una Factura o a un Presupuesto

' ---------- Asociaciones ----------
ConfiguracionSistema "1" --> "0..*" ConexionPasarelaCobro : -pasarelasConfiguradas
ConfiguracionSistema "1" --> "0..*" PlantillaMensaje : -plantillasNotificacion
ConfiguracionSistema "1" --> "1..*" CalendarioLaboral : -calendarios
ConfiguracionSistema "1" --> "1..*" TarifaRango : -tablaTarifas
ConfiguracionSistema "1" --> "1..*" SerieFacturacion : -seriesConfiguradas

AlertaCorporativa "0..*" --> "0..*" Usuario : -destinatarios
Usuario "0..1" --> "0..*" Cliente : -clientesAsignados
Usuario "0..*" --> "0..*" Cliente : -favoritos
Usuario "1" --> "0..*" Notificacion : -notificaciones
DelegacionTemporal "0..*" --> "1" Usuario : -titular
DelegacionTemporal "0..*" --> "1" Usuario : -sustituto
DelegacionTemporal "0..*" --> "0..*" Cliente : -clientesDelegados

Comentario "0..*" --> "1" Usuario : -autor
Comentario "0..*" --> "0..*" Usuario : -mencionados
Comentario "0..*" --> "0..1" Cliente
Comentario "0..*" --> "0..1" Factura
Comentario "0..*" --> "0..1" Incidencia
note bottom of Comentario : {xor} sobre un cliente,\nuna factura o una incidencia

DocumentoAdjunto "0..*" --> "1" Usuario : -subidoPor
DocumentoAdjunto "0..*" <-- "0..1" Cliente
DocumentoAdjunto "0..*" <-- "0..1" Factura
DocumentoAdjunto "0..*" <-- "0..1" Incidencia
note bottom of DocumentoAdjunto : {xor} cada documento pertenece\na un único elemento

RegistroAuditoria "0..*" --> "0..1" Usuario : -autor
CopiaSeguridad "0..*" --> "0..1" EjecucionProceso : -ejecucionOrigen
CopiaSeguridad "0..*" --> "0..1" Usuario : -restauradaPor

Cliente "0..*" --> "1" TarifaRango : -rangoActual
Cliente "1" --> "0..*" RevisionRango : -historialRevisiones
RevisionRango "0..*" --> "1" TarifaRango : -rangoAnterior
RevisionRango "0..*" --> "1" TarifaRango : -rangoNuevo
ImportacionClientes "0..*" --> "1" Usuario : -ejecutadoPor

Cliente "1" --> "0..*" Suscripcion : -suscripciones
Suscripcion "1" --> "0..*" ExcepcionComercial : -excepciones
Cliente "1" --> "0..*" Factura : -facturas
Cliente "1" --> "0..*" Presupuesto : -presupuestos
Suscripcion "0..1" --> "0..*" Factura : -facturasGeneradas
Presupuesto "0..1" --> "0..1" DocumentoAdjunto : -evidencia
Presupuesto "0..1" --> "0..1" Factura : -facturaGenerada

LineaFactura "0..*" --> "0..1" ProductoCatalogo : -productoOrigen
Factura "0..*" --> "0..1" SerieFacturacion : -serie
Factura "0..1" --> "0..1" DocumentoAdjunto : -pdfEmitido
Factura "0..1" <-- "0..*" Factura : -facturaOriginal
Factura "1" --> "0..*" EnvioFactura : -historialEnvios
EnvioFactura "0..*" --> "1" PlantillaMensaje : -plantillaUsada

SolicitudAprobacion "0..*" --> "1" Usuario : -solicitante
SolicitudAprobacion "0..*" --> "0..1" Usuario : -aprobador
SolicitudAprobacion "0..*" --> "0..1" Usuario : -asignadoA
SolicitudAprobacion "0..1" <-- "0..1" RevisionRango
SolicitudAprobacion "0..1" <-- "0..1" ExcepcionComercial
SolicitudAprobacion "0..*" <-- "0..1" Factura
SolicitudAprobacion "0..*" <-- "0..1" Suscripcion
note bottom of SolicitudAprobacion : {xor} cada solicitud se refiere\na un único elemento

Factura "0..1" --> "0..*" Cobro : -cobros
Cobro "0..1" --> "0..1" DocumentoAdjunto : -justificante
Factura "1" --> "0..*" RecordatorioImpago : -recordatorios
RecordatorioImpago "0..*" --> "1" PlantillaMensaje : -plantillaUsada

Incidencia "0..*" --> "0..1" Cliente
Incidencia "0..*" --> "0..1" Factura
Incidencia "0..*" --> "1" Usuario : -responsable
note bottom of Incidencia : {xor} sobre un cliente\no sobre una factura

Informe "0..*" --> "1" Usuario : -generadoPor
Informe "0..*" --> "0..1" Cliente : -filtroCliente
Informe "0..*" --> "0..1" Usuario : -filtroResponsable
Informe "0..1" --> "0..1" DocumentoAdjunto : -archivoGenerado
PaqueteGestoria "0..*" --> "1" PeriodoContable : -periodoAsociado
PaqueteGestoria "0..1" --> "0..1" DocumentoAdjunto : -archivoZip
PaqueteGestoria "0..*" --> "1" Usuario : -generadoPor
AccionMasiva "0..*" --> "1" Usuario : -ejecutadoPor
AccionMasiva "0..1" --> "0..*" Informe : -informesGenerados

' ---------- Dependencias ----------
Factura ..> PeriodoContable : <<uses>>
Factura ..> ConfiguracionSistema : <<uses>>
RecordatorioImpago ..> CalendarioLaboral : <<uses>>
SolicitudAprobacion ..> ConfiguracionSistema : <<uses>>
RevisionRango ..> ConfiguracionSistema : <<uses>>




@startuml
skinparam actorstyle awesome
left to right direction
title Configuración, auditoría y datos

actor :Administrador: as admin
actor :Superadministrador: as superadmin
actor :Planificador (tiempo): as planificador
actor :Sistema de cobros: as cobros
actor :Servicio de mensajería: as mensajeria

superadmin --|> admin
usecase "CU-03\nConfiguración global del sistema" as cu03
usecase "CU-04\nAdministración de la cuenta\nde recepción de pagos" as cu04
usecase "CU-20\nAuditoría y copias de seguridad" as cu20
usecase "CU-24\nGeneración de copias de seguridad" as cu24
usecase "CU-34\nCierre y reapertura de periodos" as cu34
usecase "CU-35\nGestión de datos personales" as cu35

admin -- cu34
admin -- cu35

superadmin -- cu03
superadmin -- cu04
superadmin -- cu20

planificador -- cu24

cu03 -- mensajeria
cu04 -- cobros

cu20 ..> cu24 : <<dependency>>
cu24 ..> cu03 : <<dependency>>
@enduml

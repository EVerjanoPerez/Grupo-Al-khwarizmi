@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam MaxMessageWidth 250

title Bloque 5: Informes y Paquetes de Gestoría (Turbine)

actor "Usuario" as UsuarioActor
actor "Administrador" as AdminActor

participant ":Controlador / Interfaz" as UI
participant ":Informe" as Informe
participant ":PaqueteGestoria" as Paquete
participant "archivo:DocumentoAdjunto" as Archivo
participant "zip:DocumentoAdjunto" as Zip

' --- MENSAJES ---
UsuarioActor -> UI: consultaCobrosMetricasEInformes(filtros, formato) (CU-09)
activate UI
create Informe
UI -> Informe: create(filtros, formato)
UI -> Informe: generar()
create Archivo
Informe -> Archivo: create(archivoGenerado)
UI -> Informe: notificarListo()
UI --> UsuarioActor: Entrega de informe generado

AdminActor -> UI: solicitarPaqueteGestoria(idPeriodo) (CU-09 1b)
create Paquete
UI -> Paquete: create(periodo)
UI -> Paquete: compilarPaquete()
create Zip
Paquete -> Zip: create(archivoZip)
UI -> Paquete: descargarZip()
UI --> AdminActor: Descarga de archivo comprimido
deactivate UI
@enduml
